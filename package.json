{
  "name": "notification-server",
  "packageManager": "yarn@4.13.0",
  "version": "1.2.0",
  "description": "Notification server for the AnzuSystems platform",
  "license": "Apache-2.0",
  "author": "AnzuSystems",
  "contributors": [
    {
      "name": "AnzuSystems Community",
      "homepage": "https://github.com/orgs/anzusystems/people"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "ci": "yarn lint:tsc && yarn lint:eslint",
    "lint": "yarn ci",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:prettier": "prettier -c \"./src/**/*.{ts,js}\"",
    "lint:prettier:fix": "prettier -w \"./src/**/*.{ts,js}\"",
    "lint:tsc": "tsc --noEmit -p tsconfig.json --composite false",
    "clean": "rimraf dist",
    "build": "yarn clean && yarn lint && tsc && tsc-alias",
    "production": "yarn build",
    "prod": "NODE_OPTIONS=\"--max-old-space-size=200\" node dist/src/index.js --max-http-header-size=16000",
    "dev": "TS_NODE=true NODE_OPTIONS=\"-r ts-node/register\" node src/index.ts --max-http-header-size=16000",
    "watch": "nodemon --watch src -e ts --exec yarn dev",
    "test": "jest --coverage=true --runInBand"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "cookies": "^0.9.1",
    "dotenv": "^17.3.1",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0",
    "winston": "^3.19.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.9.0",
    "@types/cookies": "^0.9.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unicorn": "^63.0.0",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
