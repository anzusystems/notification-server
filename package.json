{
  "name": "notification-server",
  "packageManager": "yarn@4.15.0",
  "version": "1.2.1",
  "description": "Notification server for the AnzuSystems platform",
  "license": "Apache-2.0",
  "author": "AnzuSystems",
  "contributors": [
    {
      "name": "AnzuSystems Community",
      "homepage": "https://github.com/orgs/anzusystems/people"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "ci": "yarn lint:tsc && yarn lint:oxlint",
    "lint": "[ \"$*\" = \"--fix\" ] && yarn lint:fix || yarn ci",
    "lint:fix": "yarn lint:tsc && yarn lint:oxfmt:fix && yarn lint:oxlint:fix",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:fix": "oxlint --fix .",
    "lint:oxfmt": "oxfmt --check \"./src/**/*.{ts,js}\"",
    "lint:oxfmt:fix": "oxfmt --write \"./src/**/*.{ts,js}\"",
    "lint:tsc": "tsc --noEmit -p tsconfig.json --composite false",
    "clean": "rimraf dist",
    "build": "yarn clean && yarn lint && tsc && tsc-alias",
    "production": "yarn build",
    "prod": "NODE_OPTIONS=\"--max-old-space-size=200 --max-http-header-size=65536\" node dist/src/index.js",
    "dev": "TS_NODE=true NODE_OPTIONS=\"-r ts-node/register --max-http-header-size=65536\" node src/index.ts",
    "watch": "nodemon --watch src -e ts --exec yarn dev",
    "test": "jest --coverage=true --runInBand"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^5.3.0",
    "cookies": "^0.9.1",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0",
    "winston": "^3.19.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cookies": "^0.9.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.4",
    "@types/ws": "^8.18.1",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
